{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "SumItUp Python API (npm scripts for monorepo compatibility)",
  "scripts": {
    "dev": ".venv/bin/python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 3000",
    "start": ".venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 3000",
    "test:unit": ".venv/bin/pytest -q",
    "test:coverage": ".venv/bin/pytest --cov=app --cov-report=term-missing"
  }
}
